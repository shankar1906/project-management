{
  "name": "project-management-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "__PRISMA_ORIGINAL__": "── Original commands (kept as-is) ─────────────────────────",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "backfill:owner": "ts-node -r tsconfig-paths/register scripts/backfill-organization-owner.ts",
    "backfill:org-settings": "ts-node -r tsconfig-paths/register scripts/backfill-org-settings.ts",
    "migrate:structure": "ts-node -r tsconfig-paths/register scripts/migrate-hierarchical-structure.ts",
    "backfill:task-ids": "ts-node -r tsconfig-paths/register scripts/backfill-task-ids.ts",
    "__PRISMA_SMART__": "── Smart migration commands (use these!) ───────────────────",
    "db:deploy": "ts-node -r tsconfig-paths/register scripts/prisma-migrate.ts deploy",
    "db:dev": "ts-node -r tsconfig-paths/register scripts/prisma-migrate.ts dev",
    "db:status": "ts-node -r tsconfig-paths/register scripts/prisma-migrate.ts status",
    "db:reset": "ts-node -r tsconfig-paths/register scripts/prisma-migrate.ts reset",
    "db:generate": "ts-node -r tsconfig-paths/register scripts/prisma-migrate.ts generate",
    "db:validate": "ts-node -r tsconfig-paths/register scripts/prisma-migrate.ts validate",
    "__PRISMA_NAMED__": "── Create a named migration (set MIGRATION_NAME=your_name first) ──",
    "db:migrate:named": "cross-env MIGRATION_NAME=%MIGRATION_NAME% ts-node -r tsconfig-paths/register scripts/prisma-migrate.ts dev",
    "__PRISMA_RESOLVE__": "── Fix stuck / drifted migrations ──────────────────────────────",
    "db:baseline": "ts-node -r tsconfig-paths/register scripts/prisma-baseline.ts",
    "prisma:resolve:applied": "prisma migrate resolve --applied",
    "prisma:resolve:rolled-back": "prisma migrate resolve --rolled-back",
    "prisma:diff": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$DATABASE_URL\"",
    "__PRISMA_STUDIO__": "── GUI & introspection ──────────────────────────────────────────",
    "prisma:studio": "prisma studio",
    "prisma:introspect": "prisma db pull",
    "prisma:push": "prisma db push --accept-data-loss",
    "prisma:format": "prisma format"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.11",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.11",
    "@prisma/client": "^5.21.0",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.44.0",
    "axios": "^1.13.2",
    "axios-retry": "^4.5.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.0",
    "nestjs-pino": "^4.5.0",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sib-api-v3-sdk": "^8.5.0",
    "socket.io": "^4.8.3",
    "twilio": "^5.11.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "^5.21.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}